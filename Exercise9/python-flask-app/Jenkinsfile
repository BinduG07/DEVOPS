
pipeline {
    agent any

    environment {
        APP_DIR = 'Exercise9/python-flask-app'
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                dir("${APP_DIR}") {
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                dir("${APP_DIR}") {
                    sh '''
                        .venv/bin/python -m unittest discover \
                            -s . -p "test*.py" -v
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Preparing deployment...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp "$APP_DIR/app.py" "$DEPLOY_DIR/"
                    cp "$APP_DIR/requirements.txt" "$DEPLOY_DIR/"
                    cp "$APP_DIR/test_app.py" "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        kill "$(cat "$DEPLOY_DIR/app.pid")" 2>/dev/null || true
                    fi

                    nohup "$WORKSPACE/$APP_DIR/.venv/bin/python" \
                        "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &

                    echo $! > "$DEPLOY_DIR/app.pid"
                    sleep 2
                    cat "$DEPLOY_DIR/app.log"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the deployed application...'
                sh '''
                    "$WORKSPACE/$APP_DIR/.venv/bin/python" \
                        "$DEPLOY_DIR/test_app.py"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
